{
  "name": "ciphermask",
  "version": "1.0.0",
  "private": true,
  "description": "CipherMask — Multimodal Privacy Intelligence Platform (100% client-side)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-profile.mjs strict",
    "build:strict": "node scripts/build-profile.mjs strict",
    "build:cloud": "node scripts/build-profile.mjs cloud",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:privacy": "playwright test tests/e2e/privacy-v2.spec.ts",
    "benchmark": "npx tsx src/engine/benchmark/cli.ts",
    "setup:assets": "node scripts/setup-assets.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "setup:models": "node scripts/setup-models.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "cloud:relay": "node optional-relay/server.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "deploy:hosting": "npm run verify && npm run verify:deploy && firebase deploy --only hosting --project ciphermask-94dbd",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build:strict"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-genai": "^0.10.30",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@tailwindcss/vite": "^4.3.5",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "exifr": "^7.1.3",
    "ipaddr.js": "^2.5.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.81.0",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
